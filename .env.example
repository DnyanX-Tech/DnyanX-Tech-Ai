# ==========================================
# DnyanX AI - Environment Variables Template
# ==========================================

# OpenAI API Key (Required for GPT-4o completions & embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Connection URL with pgvector support
# Example for Supabase DB: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Example for Local Docker DB: postgresql://postgres:postgrespassword@localhost:5432/dnyanx_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/dnyanx_db

# Supabase Credentials (Optional if using direct PostgreSQL DATABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Frontend API Endpoint Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
